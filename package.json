{
  "name": "flocked",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.23"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:test",
    "lint": "eslint scripts && pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "node --test --test-reporter=spec scripts/*.test.mjs && pnpm -r --if-present test",
    "contracts:build": "forge build --root contracts && node packages/abi/scripts/gen.mjs",
    "contracts:test": "forge test --root contracts",
    "spec": "node scripts/spec-section.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
