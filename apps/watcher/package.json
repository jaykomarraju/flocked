{
  "name": "@flocked/watcher",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Independent verification watcher: re-verifies Flocked rounds from public data in a separate Cloudflare account, signs verdicts and pages the guardian.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "5.20261008.1",
    "wrangler": "4.148.0"
  },
  "dependencies": {
    "@flocked/abi": "workspace:*",
    "@flocked/settle": "workspace:*",
    "@flocked/tlock": "workspace:*",
    "@flocked/verify": "workspace:*",
    "viem": "2.57.3",
    "zod": "4.6.5"
  }
}
