{
  "name": "@flocked/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flocked web app (React + Vite): the browser app and the Farcaster/Base mini app. Served by the API Worker's assets binding.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-org/account": "2.5.13",
    "@farcaster/miniapp-sdk": "0.3.0",
    "@flocked/shared": "workspace:*",
    "@fontsource-variable/fredoka": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.104.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.4.0",
    "viem": "2.57.3",
    "wagmi": "3.7.7",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "vite": "8.3.4"
  }
