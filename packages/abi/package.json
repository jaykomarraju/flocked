{
  "name": "@flocked/abi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generated TypeScript ABIs and deployment addresses for the Flocked contracts.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "gen": "node scripts/gen.mjs",
    "gen:check": "node scripts/gen.mjs --check",
    "fixtures": "node scripts/receipt-fixture.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "viem": "2.57.3"
  }
}
