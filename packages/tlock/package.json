{
  "name": "@flocked/tlock",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flocked timelock wrapper: pinned drand chain config, beacon math, plaintext codec, canonical headers, BLS beacon verification and VOID classification.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "vectors"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "vectors": "tsx scripts/gen-vectors.ts"
  },
  "dependencies": {
    "@flocked/settle": "workspace:*",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "tlock-js": "0.9.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "fast-check": "4.10.2",
    "tsx": "4.23.15"
  }
}
