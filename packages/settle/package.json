{
  "name": "@flocked/settle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flocked settlement engine: payout math, Stakes closed form, invariant and Merkle trees.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "vectors": "tsx scripts/gen-vectors.ts"
  },
  "dependencies": {
    "@openzeppelin/merkle-tree": "1.0.8",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "20.19.43",
    "eslint": "10.12.0",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  }
}
