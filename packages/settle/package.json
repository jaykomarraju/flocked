    "test": "vitest run",
    "vectors": "tsx scripts/gen-vectors.ts"
  },
  "dependencies": {
    "@openzeppelin/merkle-tree": "1.0.8",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "tsx": "4.23.15"
  }
}
