{
  "name": "@flocked/settle",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Flocked settlement engine: payout math, Stakes closed form, invariant and Merkle trees.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "vectors"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
